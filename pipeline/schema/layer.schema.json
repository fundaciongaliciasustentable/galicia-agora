{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galicia-agora/schema/layer.schema.json",
  "title": "Layer definition (layer.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "theme",
    "operator",
    "source_url",
    "licence",
    "attribution",
    "update_frequency",
    "geometry",
    "output",
    "auth",
    "privacy_notes",
    "style",
    "table"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gl", "es"],
      "properties": {
        "gl": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 }
      }
    },
    "theme": {
      "enum": ["auga-mar", "lume-monte", "tempo-aire", "mobilidade", "territorio"]
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "source_url": { "type": "string", "format": "uri" },
    "licence": { "$ref": "#/$defs/licence" },
    "attribution": { "type": "string", "minLength": 1 },
    "update_frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared"],
      "properties": {
        "declared": { "$ref": "#/$defs/durationOrStatic" },
        "measured": { "$ref": "#/$defs/durationOrStatic" },
        "schedule": { "type": "string", "description": "cron expression for the ingest job" }
      }
    },
    "geometry": { "enum": ["point", "line", "polygon", "raster", "none"] },
    "output": { "enum": ["geojson", "ndjson", "pmtiles"] },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "env_var": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "required": { "const": true } } },
      "then": { "required": ["env_var"] }
    },
    "privacy_notes": { "type": "string", "minLength": 1 },
    "stale_after": { "$ref": "#/$defs/duration" },
    "ingest": {
      "description": "How often the ingest job should refresh this layer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["every"],
      "properties": { "every": { "$ref": "#/$defs/duration" } }
    },
    "context": {
      "description": "Extra facts shown next to the layer (e.g. discordant official figures), each with its source.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "source", "source_url"],
        "properties": {
          "label": {
            "type": "object",
            "required": ["gl", "es"],
            "properties": { "gl": { "type": "string" }, "es": { "type": "string" } }
          },
          "value": { "type": "string" },
          "source": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "note": {
            "type": "object",
            "required": ["gl", "es"],
            "properties": { "gl": { "type": "string" }, "es": { "type": "string" } }
          }
        }
      }
    },
    "delay": {
      "description": "Publication delay applied before showing data (privacy or source rule).",
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "reason"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      }
    },
    "style": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["circle", "symbol", "line", "fill", "heatmap", "raster"] },
        "color_token": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
        "label_field": { "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^P(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
    },
    "durationOrStatic": {
      "anyOf": [{ "$ref": "#/$defs/duration" }, { "const": "static" }]
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_url", "verified_at", "odbl_compatible", "collection"],
      "if": { "properties": { "odbl_compatible": { "const": true } } },
      "else": { "properties": { "collection": { "const": "cc-by-sa-4.0" } } },
      "properties": {
        "spdx": { "type": "string" },
        "text_url": { "type": "string", "format": "uri" },
        "quote": { "type": "string", "maxLength": 200 },
        "verified_at": { "type": "string", "format": "date" },
        "odbl_compatible": { "enum": [true, false, "doubt"] },
        "collection": {
          "description": "Which published collection the layer belongs to (ADR 0005).",
          "enum": ["odbl", "cc-by-sa-4.0"]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
