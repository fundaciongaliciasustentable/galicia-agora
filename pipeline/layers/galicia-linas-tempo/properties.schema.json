{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "galicia-linas-tempo feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "orde",
    "filas",
    "columnas",
    "fotogramas",
    "totais",
    "unidade",
    "fonte",
    "perfis"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "orde": { "type": "integer", "minimum": 0 },
    "filas": { "type": "integer", "minimum": 1 },
    "columnas": { "type": "integer", "minimum": 1 },
    "fotogramas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" }
    },
    "totais": { "type": "array", "items": { "type": "number", "minimum": 0 } },
    "unidade": { "type": "string" },
    "fonte": { "type": "string", "minLength": 1 },
    "perfis": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9+/]+=*$" } }
  }
}
