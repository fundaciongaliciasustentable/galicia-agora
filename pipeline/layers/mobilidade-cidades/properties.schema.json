{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mobilidade-cidades feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codigo_ine",
    "nome",
    "dias_mercores",
    "dias_domingo",
    "anel0",
    "anel1",
    "residentes_anel0",
    "residentes_anel1",
    "entradas_mercores_anel0",
    "saidas_mercores_anel0",
    "presenza_max_mercores_anel0",
    "presenza_max_pct_mercores_anel0",
    "entradas_domingo_anel0",
    "saidas_domingo_anel0",
    "presenza_max_domingo_anel0",
    "presenza_max_pct_domingo_anel0",
    "entradas_mercores_anel1",
    "saidas_mercores_anel1",
    "presenza_max_mercores_anel1",
    "presenza_max_pct_mercores_anel1",
    "entradas_domingo_anel1",
    "saidas_domingo_anel1",
    "presenza_max_domingo_anel1",
    "presenza_max_pct_domingo_anel1"
  ],
  "patternProperties": {
    "^(entradas|saidas|presenza_max)_(mercores|domingo)_anel[01]$": {
      "type": "integer",
      "minimum": 0
    },
    "^presenza_max_pct_(mercores|domingo)_anel[01]$": { "type": "number", "minimum": 0 },
    "^residentes_anel[01]$": { "type": "integer", "minimum": 1 }
  },
  "properties": {
    "codigo_ine": { "type": "string", "pattern": "^\\d{5}$" },
    "nome": { "type": "string", "minLength": 1 },
    "dias_mercores": { "$ref": "#/$defs/days" },
    "dias_domingo": { "$ref": "#/$defs/days" },
    "anel0": { "$ref": "#/$defs/ring" },
    "anel1": { "$ref": "#/$defs/ring" }
  },
  "$defs": {
    "days": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    },
    "hours": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "type": "integer", "minimum": 0 }
    },
    "hourly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entradas", "saidas", "internas"],
      "properties": {
        "entradas": { "$ref": "#/$defs/hours" },
        "saidas": { "$ref": "#/$defs/hours" },
        "internas": { "$ref": "#/$defs/hours" }
      }
    },
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concellos", "residentes", "mercores", "domingo"],
      "properties": {
        "concellos": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^\\d{5}$" }
        },
        "residentes": { "type": "integer", "minimum": 1 },
        "mercores": { "$ref": "#/$defs/hourly" },
        "domingo": { "$ref": "#/$defs/hourly" }
      }
    }
  }
}
