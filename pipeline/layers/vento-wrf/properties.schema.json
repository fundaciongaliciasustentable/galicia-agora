{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vento-wrf feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": ["execucion", "ficheiro", "horas", "grella", "cuantizacion_ms", "vento_max_ms", "uv"],
  "properties": {
    "execucion": { "type": "string", "format": "date-time" },
    "ficheiro": { "type": "string", "pattern": "^wrf_2d_04km/" },
    "horas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "date-time" }
    },
    "grella": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lon0", "lat0", "dlon", "dlat", "nx", "ny"],
      "properties": {
        "lon0": { "type": "number" },
        "lat0": { "type": "number" },
        "dlon": { "type": "number", "exclusiveMinimum": 0 },
        "dlat": { "type": "number", "exclusiveMinimum": 0 },
        "nx": { "type": "integer", "minimum": 2 },
        "ny": { "type": "integer", "minimum": 2 }
      }
    },
    "cuantizacion_ms": { "type": "number", "exclusiveMinimum": 0 },
    "vento_max_ms": { "type": "number", "minimum": 0, "maximum": 80 },
    "uv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9+/]+=*$" }
    }
  }
}
