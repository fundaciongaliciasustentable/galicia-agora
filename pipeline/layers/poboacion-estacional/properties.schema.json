{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "poboacion-estacional feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codigo_ine",
    "nome",
    "trimestres",
    "provisional",
    "carga",
    "residentes",
    "entrada",
    "saida",
    "taxa",
    "turismo",
    "segundas_vivendas",
    "estudos",
    "traballo",
    "saude",
    "galicia_taxa",
    "taxa_carga",
    "taxa_carga_galicia",
    "taxa_carga_rel",
    "taxa_carga_periodo"
  ],
  "properties": {
    "codigo_ine": {
      "type": "string",
      "pattern": "^\\d{5}$"
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "trimestres": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}/(I|II|III|IV)$"
      }
    },
    "provisional": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "carga": {
      "$ref": "#/$defs/quarters"
    },
    "residentes": {
      "$ref": "#/$defs/quarters"
    },
    "entrada": {
      "$ref": "#/$defs/quarters"
    },
    "saida": {
      "$ref": "#/$defs/quarters"
    },
    "taxa": {
      "$ref": "#/$defs/quarters"
    },
    "turismo": {
      "$ref": "#/$defs/quarters"
    },
    "segundas_vivendas": {
      "$ref": "#/$defs/quarters"
    },
    "estudos": {
      "$ref": "#/$defs/quarters"
    },
    "traballo": {
      "$ref": "#/$defs/quarters"
    },
    "saude": {
      "$ref": "#/$defs/quarters"
    },
    "galicia_taxa": {
      "$ref": "#/$defs/quarters"
    },
    "taxa_carga": {
      "type": ["number", "null"]
    },
    "taxa_carga_galicia": {
      "type": ["number", "null"]
    },
    "taxa_carga_rel": {
      "type": ["number", "null"]
    },
    "taxa_carga_periodo": {
      "type": "string"
    }
  },
  "$defs": {
    "quarters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": ["number", "null"]
      }
    }
  }
}
