{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vut-mensual feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": ["codigo_ine", "nome", "periodos", "vut", "prazas", "poboacion_2021", "valor"],
  "properties": {
    "codigo_ine": { "type": "string", "pattern": "^\\d{5}$" },
    "nome": { "type": "string", "minLength": 1 },
    "periodos": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}M\\d{2}$" } },
    "vut": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "prazas": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "poboacion_2021": { "type": ["integer", "null"] },
    "valor": { "type": "array", "items": { "type": ["number", "null"], "minimum": 0 } }
  }
}
