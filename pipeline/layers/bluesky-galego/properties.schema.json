{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bluesky-galego feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codigo_ine",
    "nome",
    "consulta",
    "poboacion_2021",
    "desde",
    "mencions",
    "valor",
    "galego",
    "galego_permil",
    "mostra_min",
    "mostras"
  ],
  "properties": {
    "codigo_ine": { "type": "string", "pattern": "^\\d{5}$" },
    "nome": { "type": "string", "minLength": 1 },
    "consulta": { "type": "string", "minLength": 1 },
    "poboacion_2021": { "type": ["integer", "null"] },
    "desde": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mencions": { "type": "array", "items": { "type": ["integer", "null"], "minimum": 10 } },
    "valor": { "type": "array", "items": { "type": ["number", "null"], "minimum": 0 } },
    "galego": { "type": "array", "items": { "type": ["integer", "null"], "minimum": 0 } },
    "galego_permil": { "type": "array", "items": { "type": ["number", "null"], "minimum": 0 } },
    "mostra_min": { "type": "array", "items": { "type": ["integer", "null"], "minimum": 0 } },
    "mostras": {
      "type": "object",
      "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
