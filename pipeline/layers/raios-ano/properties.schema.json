{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "raios-ano feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": ["dia", "periodo_inicio", "periodo_fin", "n", "segundo", "lon", "lat", "ka"],
  "properties": {
    "dia": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "periodo_inicio": { "type": "string", "pattern": "^\\d{4}-\\d{2}-01$" },
    "periodo_fin": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "n": { "type": "integer", "minimum": 1 },
    "segundo": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 90000 } },
    "lon": { "type": "array", "items": { "type": "number" } },
    "lat": { "type": "array", "items": { "type": "number" } },
    "ka": { "type": "array", "items": { "type": ["integer", "null"] } }
  }
}
