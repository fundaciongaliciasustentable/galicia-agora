<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
	<atom:author>
		<atom:name>Xunta de Galicia</atom:name>
	</atom:author>
	<atom:link href="https://benestar.xunta.es/XiacWeb/" rel="related"/>
	<name>Centros de benestar</name>
	<open>1</open>
	<description>575 centros de benestar da área de infancia</description>

	<Style id="TemaXunta">
		<IconStyle>
			<Icon>
				<href>http://maps.google.com/mapfiles/kml/shapes/schools.png</href>
			</Icon>
		</IconStyle>
		<LineStyle>
			<color>00B67F06</color>
			<width>4</width>
		</LineStyle>
		<PolyStyle>
			<color>92E09E00</color>
		</PolyStyle>
		<LabelStyle>
			<color>FFFFFFFF</color>
		</LabelStyle>
		<BalloonStyle>
			<bgColor>FFB67F06</bgColor>
			<textColor>FFFFFFFF</textColor>

			<text><![CDATA[
				<style type="text/css">ul li{list-style-type:none;}</style>
				<p><strong>$[name]</strong><br />
					<em>$[description]</em></p>
				<p><strong>Contacto:</strong>
				<ul>
					<li><strong>$[Enderezo/displayName]:</strong></li>
					<p>$[Enderezo]<br/>$[CodigoPostal] $[Concello]<br/>$[Provincia]</p>
					<li><strong>$[Telefono/displayName]:</strong> $[Telefono]</li>
					<li>$[Correo]</li>
				</ul>
				<p><strong>Horario:</strong> $[Horario]</p>
				<p><strong>Instalacións:</strong> $[Instalacions]</p>
				<p><strong>Servizos:</strong> $[Servizos]</p>
			]]></text>
		</BalloonStyle>
	</Style>

	<ScreenOverlay>
		<name>Xunta de Galicia</name>
		<visibility>1</visibility>
		<Icon>
			<href>http://www.xunta.es/tema-portal-xunta/images/logoXuntaPe.png</href>
		</Icon>
		<overlayXY x="0.1" xunits="fraction" y="1.1" yunits="fraction"/>
		<screenXY x="0.01" xunits="fraction" y="1" yunits="fraction"/>
		<rotationXY x="0" xunits="fraction" y="0" yunits="fraction"/>
		<size x="0" xunits="fraction" y="0" yunits="fraction"/>
	</ScreenOverlay>

	<Folder id="acoruna">
