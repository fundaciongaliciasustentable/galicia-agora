{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seculo-movemento feature properties",
  "type": "object",
  "additionalProperties": false,
  "required": ["codigo_ine", "nome", "censos", "poboacion", "anclas"],
  "properties": {
    "codigo_ine": { "type": "string", "pattern": "^\\d{5}$" },
    "nome": { "type": "string", "minLength": 1 },
    "censos": { "type": "array", "items": { "type": "integer" } },
    "poboacion": { "type": "array", "items": { "type": ["integer", "null"], "minimum": 0 } },
    "anclas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
