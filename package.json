{
  "name": "galicia-agora",
  "version": "0.0.1",
  "private": true,
  "description": "Mapa público de Galicia con datos abertos. Fundación Galicia Sustentable.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "echo \"site/ arrives in Phase 1\" && exit 1",
    "build": "echo \"site/ arrives in Phase 1\" && exit 1",
    "test": "vitest run",
