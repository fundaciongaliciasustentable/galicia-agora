---
// The concello portrait moved to its own site on 27/10/2026. This page keeps old links
// working: it sends visitors there, keeping the hash (#c=…&i=…) of shared views.
const DEST = 'https://concellos.galiciasustentable.org/es/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Retrato — Mapas Galicia Sustentable</title>
    <link rel="canonical" href={DEST} />
    <meta http-equiv="refresh" content={`0; url=${DEST}`} />
    <script is:inline define:vars={{ DEST }}>
      window.location.replace(DEST + window.location.hash);
    </script>
  </head>
  <body>
    <p>El retrato de los ayuntamientos tiene ahora sitio propio: <a href={DEST}>{DEST}</a></p>
  </body>
</html>
