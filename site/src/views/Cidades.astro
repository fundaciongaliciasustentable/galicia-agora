---
// Trips into and out of the seven cities through a mean Wednesday and Sunday (May 2025).
// Each city breathes with its running balance in % of its residents; particles stand for
// trips. The same figures are given as text: panel, small multiples (labelled) and a table.
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="ci-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="ci-map" role="region" aria-label={t(lang, 'cities_map_label')}></div>
  <canvas class="ci-canvas" aria-hidden="true"></canvas>

  <section class="ci-panel" id="contido">
    <a class="ci-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'cities_title')}</h1>
    <p class="ci-lede">{t(lang, 'cities_lede')}</p>
    <p class="ci-clock" aria-live="off">--:--</p>
    <p class="ci-now" aria-live="off"></p>
    <div class="ci-controls">
      <div class="ci-seg" role="group" aria-label={t(lang, 'pulse_day')}>
        <button type="button" data-day="mercores" aria-pressed="true">{t(lang, 'pulse_weekday')}</button>
        <button type="button" data-day="domingo" aria-pressed="false">{t(lang, 'pulse_sunday')}</button>
      </div>
      <div class="ci-seg" role="group" aria-label={t(lang, 'cities_ring')}>
        <button type="button" data-ring="anel0" aria-pressed="false">{t(lang, 'cities_ring0')}</button>
        <button type="button" data-ring="anel1" aria-pressed="true">{t(lang, 'cities_ring1')}</button>
      </div>
    </div>
    <div class="ci-controls">
      <button type="button" class="ci-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
      <label>
        <span class="visually-hidden">{t(lang, 'pulse_speed')}</span>
        <select class="ci-speed"></select>
      </label>
    </div>
    <label class="ci-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="ci-range" type="range" />
    </label>
    <p class="ci-legend">
      <span class="ci-dot ci-dot-in" aria-hidden="true"></span><span class="ci-dot ci-dot-out" aria-hidden="true"></span>
      {t(lang, 'cities_legend')}
    </p>
    <p class="ci-status" role="status">{t(lang, 'loading')}</p>
    <details class="ci-table">
      <summary>{t(lang, 'cities_table')}</summary>
      <table>
        <caption></caption>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'cities_col_city')}</th>
            <th scope="col">{t(lang, 'cities_col_res')}</th>
            <th scope="col">{t(lang, 'cities_col_in')}</th>
            <th scope="col">{t(lang, 'cities_col_out')}</th>
            <th scope="col">{t(lang, 'cities_col_peak')}</th>
            <th scope="col">{t(lang, 'cities_col_hour')}</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </details>
    <details class="ci-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'cities_note')}</p>
      <p class="ci-sources"></p>
    </details>
  </section>

  <figure class="ci-curves">
    <figcaption>{t(lang, 'cities_curves')}</figcaption>
    <div class="ci-grid"></div>
  </figure>
</div>

<style is:global>
  .ci-app {
    position: relative;
    height: calc(100dvh - var(--ga-head, 52px));
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .ci-map,
  .ci-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ci-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .ci-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .ci-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .ci-back:hover,
  .ci-back:focus-visible {
    color: #fff;
  }
  .ci-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .ci-lede,
  .ci-legend,
  .ci-about,
  .ci-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .ci-about summary,
  .ci-table summary {
    cursor: pointer;
  }
  .ci-sources {
    font-size: var(--gs-texto-xs);
  }
  .ci-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .ci-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .ci-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .ci-status:empty {
    display: none;
  }
  .ci-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .ci-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .ci-seg button,
  .ci-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .ci-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .ci-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .ci-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .ci-range-label {
    display: block;
    margin-top: 10px;
  }
  .ci-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .ci-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .ci-dot-in {
    background: #ffc94d;
  }
  .ci-dot-out {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .ci-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .ci-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .ci-table th,
  .ci-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .ci-table th:first-child,
  .ci-table td:first-child {
    text-align: left;
  }
  .ci-curves {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 10px;
    margin: 0;
  }
  .ci-curves figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ci-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
    margin-top: 4px;
  }
  .ci-mini {
    margin: 0;
  }
  .ci-mini-head {
    display: flex;
    justify-content: space-between;
    gap: 4px;
    font-size: var(--gs-texto-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ci-mini-name {
    overflow: hidden;
    text-overflow: ellipsis;
    color: #e6e6df;
  }
  .ci-mini-val {
    color: #fff;
    font-weight: 600;
  }
  .ci-mini svg {
    display: block;
    width: 100%;
    height: 64px;
    cursor: ew-resize;
    touch-action: none;
  }
  .ci-zero {
    stroke: #3a3b35;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ci-area {
    fill: rgba(255, 201, 77, 0.25);
    stroke: #ffc94d;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .ci-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .ci-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .ci-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .ci-lede,
    .ci-legend {
      display: none;
    }
    .ci-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .ci-now {
      min-height: 0;
    }
    .ci-controls {
      margin-top: 8px;
    }
    .ci-curves {
      left: 8px;
      right: 8px;
    }
    .ci-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 4px 6px;
    }
    .ci-mini svg {
      height: 36px;
    }
  }
</style>

<script>
  import { start } from '../pulso/cidades/cidades';
  start();
</script>
