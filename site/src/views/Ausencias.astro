---
// As ausencias: a night map of the 30,500 population entities of Galicia (aldeas-baleiras
// layer), lights where people live and empty rings where nobody does, year by year since 2000.
// The same figures are given as text: the count, the names of the places emptied each year, the
// picked place's detail and the wall of names (table).
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="au-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="au-map" role="region" aria-label={t(lang, 'absence_map_label')}></div>

  <section class="au-panel" id="contido">
    <a class="au-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'absence_title')}</h1>
    <p class="au-lede">{t(lang, 'absence_lede')}</p>
    <p class="au-clock" aria-live="off">----</p>
    <p class="au-now" aria-live="polite"></p>
    <div class="au-controls">
      <button type="button" class="au-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
    </div>
    <label class="au-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="au-range" type="range" step="1" />
    </label>
    <p class="au-names"></p>
    <div class="au-detail" aria-live="polite"></div>
    <p class="au-legend">
      <span><i class="au-key au-key-lit"></i>{t(lang, 'absence_legend_lit')}</span>
      <span><i class="au-key au-key-ghost"></i>{t(lang, 'absence_legend_ghost')}</span>
      <span><i class="au-key au-key-new"></i>{t(lang, 'absence_legend_new')}</span>
    </p>
    <p class="au-status" role="status">{t(lang, 'loading')}</p>
    <details class="au-table">
      <summary>{t(lang, 'absence_table')}</summary>
      <table>
        <caption></caption>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'absence_col_name')}</th>
            <th scope="col">{t(lang, 'fire_col_concello')}</th>
            <th scope="col">{t(lang, 'absence_col_since')}</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </details>
    <details class="au-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'absence_note')}</p>
      <p class="au-sources"></p>
    </details>
  </section>

  <figure class="au-curve">
    <figcaption>{t(lang, 'absence_curve')}</figcaption>
    <svg role="img" preserveAspectRatio="none"></svg>
  </figure>
</div>

<style is:global>
  .au-app {
    position: relative;
    height: calc(100dvh - var(--ga-head, 52px));
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .au-map,
  .au-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .au-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .au-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .au-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .au-back:hover,
  .au-back:focus-visible {
    color: #fff;
  }
  .au-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .au-lede,
  .au-legend,
  .au-about,
  .au-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .au-about summary,
  .au-table summary {
    cursor: pointer;
  }
  .au-sources {
    font-size: var(--gs-texto-xs);
  }
  .au-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .au-app .au-clock {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .au-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .au-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .au-status:empty {
    display: none;
  }
  .au-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .au-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .au-seg button,
  .au-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .au-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .au-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .au-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .au-range-label {
    display: block;
    margin-top: 10px;
  }
  .au-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .au-mode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--gs-texto-sm);
    cursor: pointer;
  }
  .au-mode input {
    width: 16px;
    height: 16px;
    accent-color: #e6e6df;
  }
  .au-scale {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: var(--gs-texto-xs);
    color: #111210;
    background: linear-gradient(90deg, #7f3b08, #e08214 25%, #fdb863 40%, #f7f7f2 50%, #b2abd2 65%, #8073ac 80%, #2d004b);
  }
  .au-scale span:first-child {
    color: #fff;
  }
  .au-scale span:last-child {
    color: #fff;
  }
  .au-scale span:nth-child(2) {
    color: #111210;
  }
  .au-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .au-dot-in {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .au-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .au-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .au-table th,
  .au-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .au-table th:first-child,
  .au-table td:first-child {
    text-align: left;
  }
  .au-curve {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 12px;
    margin: 0;
    height: 120px;
  }
  .au-curve figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .au-curve svg {
    display: block;
    width: 100%;
    height: 100px;
    cursor: ew-resize;
    touch-action: none;
  }
  .au-tick {
    fill: #8a8a82;
    font-size: 11px;
    text-anchor: middle;
  }
  .au-bar {
    fill: rgba(230, 230, 223, 0.25);
    cursor: pointer;
  }
  .au-bar.is-now {
    fill: #b2abd2;
  }
  .au-bar.is-missing {
    fill: none;
    stroke: rgba(230, 230, 223, 0.35);
    stroke-dasharray: 3 3;
  }
  .au-mine {
    fill: #fff;
  }
  .au-mine-line {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .au-detail {
    margin-top: 8px;
    font-size: var(--gs-texto-sm);
  }
  .au-detail:empty {
    display: none;
  }
  .au-detail strong {
    color: #fff;
  }
  .au-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid #fdae61;
    color: #fdae61;
    font-size: var(--gs-texto-xs);
    vertical-align: middle;
  }
  .au-area {
    fill: none;
    stroke: #ff7a3d;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .au-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .au-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .au-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .au-lede,
    .au-legend {
      display: none;
    }
    .au-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .au-now {
      min-height: 0;
    }
    .au-controls {
      margin-top: 8px;
    }
    .au-curve {
      left: 8px;
      right: 8px;
      height: 96px;
    }
    .au-curve svg {
      height: 76px;
    }
  }
  .au-app {
    background: #07080a;
  }
  .au-names {
    margin: 10px 0 0;
    font-size: var(--gs-texto-sm);
    color: #c9d3dc;
    font-style: italic;
    max-height: 9em;
    overflow-y: auto;
  }
  .au-names strong {
    font-style: normal;
    color: #fff;
  }
  .au-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .au-key {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 5px;
    vertical-align: -1px;
  }
  .au-key-lit {
    background: #ffcf70;
    box-shadow: 0 0 6px #ffcf70;
  }
  .au-key-ghost {
    border: 1.5px solid #c9d3dc;
  }
  .au-key-new {
    border: 2px solid #ffffff;
    box-shadow: 0 0 6px #fff;
  }
  .au-bar {
    fill: rgba(201, 211, 220, 0.35);
    cursor: pointer;
  }
  .au-bar.is-now {
    fill: #c9d3dc;
  }
</style>

<script>
  import { start } from '../ausencias/ausencias';
  start();
</script>
