---
// Un século en movemento: one dot per thousand people from census to census (seculo-movemento
// layer), dots sliding between concellos, or spikes of each concello's population. The same
// figures are given as text: the census, Galicia's population and what moved in each step.
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="mo-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="mo-map" role="region" aria-label={t(lang, 'move_map_label')}></div>
  <canvas class="mo-canvas" aria-hidden="true"></canvas>

  <section class="mo-panel" id="contido">
    <a class="mo-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'move_title')}</h1>
    <p class="mo-lede"></p>
    <p class="mo-clock" aria-live="off">--</p>
    <p class="mo-now" aria-live="off"></p>
    <div class="mo-controls">
      <button type="button" class="mo-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
    </div>
    <label class="mo-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="mo-range" type="range" min="0" step="0.05" value="0" />
    </label>
    <div class="mo-detail" aria-live="polite"></div>
    <div class="mo-seg" role="group" aria-label={t(lang, 'move_view')}>
      <button type="button" data-view="puntos" aria-pressed="true">{t(lang, 'move_dots')}</button>
      <button type="button" data-view="agullas" aria-pressed="false">{t(lang, 'move_spikes')}</button>
    </div>
    <p class="mo-legend" data-for="puntos">
      <span><i class="mo-key"></i>{t(lang, 'move_legend_dot')}</span>
      <span><i class="mo-key mo-key-moving"></i>{t(lang, 'move_legend_moving')}</span>
    </p>
    <p class="mo-legend" data-for="agullas" hidden>
      <span><i class="mo-key mo-key-up"></i>{t(lang, 'move_legend_up')}</span>
      <span><i class="mo-key mo-key-down"></i>{t(lang, 'move_legend_down')}</span>
    </p>
    <p class="mo-status" role="status">{t(lang, 'loading')}</p>
    <details class="mo-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'move_note')}</p>
      <p class="mo-sources"></p>
    </details>
  </section>

  <figure class="mo-curve">
    <figcaption>{t(lang, 'move_curve')}</figcaption>
    <svg role="img" preserveAspectRatio="none"></svg>
  </figure>
</div>

<style is:global>
  .mo-app {
    position: relative;
    height: calc(100dvh - var(--ga-head, 52px));
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .mo-map,
  .mo-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mo-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .mo-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .mo-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .mo-back:hover,
  .mo-back:focus-visible {
    color: #fff;
  }
  .mo-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .mo-lede,
  .mo-legend,
  .mo-about,
  .mo-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .mo-about summary,
  .mo-table summary {
    cursor: pointer;
  }
  .mo-sources {
    font-size: var(--gs-texto-xs);
  }
  .mo-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .mo-app .mo-clock {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .mo-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .mo-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .mo-status:empty {
    display: none;
  }
  .mo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .mo-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .mo-seg button,
  .mo-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .mo-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .mo-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .mo-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .mo-range-label {
    display: block;
    margin-top: 10px;
  }
  .mo-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .mo-mode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--gs-texto-sm);
    cursor: pointer;
  }
  .mo-mode input {
    width: 16px;
    height: 16px;
    accent-color: #e6e6df;
  }
  .mo-scale {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: var(--gs-texto-xs);
    color: #111210;
    background: linear-gradient(90deg, #7f3b08, #e08214 25%, #fdb863 40%, #f7f7f2 50%, #b2abd2 65%, #8073ac 80%, #2d004b);
  }
  .mo-scale span:first-child {
    color: #fff;
  }
  .mo-scale span:last-child {
    color: #fff;
  }
  .mo-scale span:nth-child(2) {
    color: #111210;
  }
  .mo-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .mo-dot-in {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .mo-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .mo-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .mo-table th,
  .mo-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .mo-table th:first-child,
  .mo-table td:first-child {
    text-align: left;
  }
  .mo-curve {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 12px;
    margin: 0;
    height: 120px;
  }
  .mo-curve figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .mo-curve svg {
    display: block;
    width: 100%;
    height: 100px;
    cursor: ew-resize;
    touch-action: none;
  }
  .mo-tick {
    fill: #8a8a82;
    font-size: 11px;
    text-anchor: middle;
  }
  .mo-bar {
    fill: rgba(230, 230, 223, 0.25);
    cursor: pointer;
  }
  .mo-bar.is-now {
    fill: #b2abd2;
  }
  .mo-bar.is-missing {
    fill: none;
    stroke: rgba(230, 230, 223, 0.35);
    stroke-dasharray: 3 3;
  }
  .mo-mine {
    fill: #fff;
  }
  .mo-mine-line {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mo-detail {
    margin-top: 8px;
    font-size: var(--gs-texto-sm);
  }
  .mo-detail:empty {
    display: none;
  }
  .mo-detail strong {
    color: #fff;
  }
  .mo-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid #fdae61;
    color: #fdae61;
    font-size: var(--gs-texto-xs);
    vertical-align: middle;
  }
  .mo-area {
    fill: none;
    stroke: #ff7a3d;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mo-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .mo-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .mo-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .mo-lede,
    .mo-legend {
      display: none;
    }
    .mo-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .mo-now {
      min-height: 0;
    }
    .mo-controls {
      margin-top: 8px;
    }
    .mo-curve {
      left: 8px;
      right: 8px;
      height: 96px;
    }
    .mo-curve svg {
      height: 76px;
    }
  }
  .mo-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .mo-seg {
    display: inline-flex;
    margin-top: 10px;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .mo-seg button {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .mo-seg button[aria-pressed='true'] {
    background: #e6e6df;
    color: #111210;
  }
  .mo-legend {
    display: flex;
    gap: 4px 14px;
    flex-wrap: wrap;
  }
  .mo-key {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f2e6c9;
    margin-right: 5px;
    vertical-align: 1px;
  }
  .mo-legend[hidden] {
    display: none;
  }
  .mo-key-up {
    background: #b2abd2;
  }
  .mo-key-down {
    background: #e08214;
  }
  .mo-key-moving {
    background: #ffb35c;
    box-shadow: 0 0 5px #ffb35c;
  }
  .mo-bar {
    fill: rgba(230, 230, 223, 0.25);
    cursor: pointer;
  }
  .mo-bar.is-now {
    fill: #e6e6df;
  }
  .mo-tscale {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: var(--gs-texto-xs);
    color: #111;
  }
  .mo-tscale span:first-child,
  .mo-tscale span:last-child {
    color: #fff;
  }
  .mo-band {
    fill: rgba(244, 109, 67, 0.22);
  }
  .mo-mean {
    fill: none;
    stroke: #fdae61;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mo-mine {
    fill: none;
    stroke: #fff;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  import { start } from '../seculo-movemento/seculo-movemento';
  start();
</script>
