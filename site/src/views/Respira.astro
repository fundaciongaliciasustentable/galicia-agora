---
// Galicia respirando: the monthly Sentinel-2 images of the whole of Galicia (previews of the
// satelite-mes and ndvi-mes layers), cross-faded month to month. The month, its scenes and its
// gaps are given as text next to the image.
import { NDVI_STOPS } from '../../../pipeline/satelite/ndvi.ts';
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ramp = `linear-gradient(90deg, ${NDVI_STOPS.map(([, c]) => c).join(', ')})`;
---

<div class="re-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="re-stage" role="img" aria-label={t(lang, 'breath_map_label')}>
    <img class="re-a" alt="" decoding="async" />
    <img class="re-b" alt="" decoding="async" />
  </div>

  <section class="re-panel" id="contido">
    <a class="re-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'breath_title')}</h1>
    <p class="re-lede">{t(lang, 'breath_lede')}</p>
    <div class="re-seg" role="group" aria-label={t(lang, 'breath_view')}>
      <button type="button" data-kind="satelite-mes" aria-pressed="true">{t(lang, 'breath_true')}</button>
      <button type="button" data-kind="ndvi-mes" aria-pressed="false">{t(lang, 'breath_ndvi')}</button>
    </div>
    <div class="re-seg re-periods" role="group" aria-label={t(lang, 'breath_period')} hidden></div>
    <p class="re-clock" aria-live="off"></p>
    <p class="re-info"></p>
    <div class="re-controls">
      <button type="button" class="re-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
      <label class="re-range-label">
        <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
        <input class="re-range" type="range" min="0" step="0.01" value="0" />
      </label>
    </div>
    <p class="re-legend" hidden>
      <span class="re-ramp" style={`background:${ramp}`} aria-hidden="true"></span>
      {t(lang, 'breath_ndvi_legend')}
    </p>
    <p class="re-status" role="status">{t(lang, 'loading')}</p>
    <details class="re-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'breath_note')}</p>
      <p class="re-sources"></p>
    </details>
  </section>
</div>

<style is:global>
  .re-app {
    position: relative;
    height: calc(100dvh - var(--ga-head, 52px));
    overflow: hidden;
    background: #0b0c0a;
    color: #e6e6df;
  }
  .re-stage {
    position: absolute;
    top: 16px;
    bottom: 16px;
    left: calc(min(380px, 40%) + 32px);
    right: 16px;
  }
  .re-stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .re-b {
    opacity: 0;
  }
  .re-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(380px, 40%);
    max-height: calc(100% - 32px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.85);
  }
  .re-back {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .re-panel h1 {
    margin: 6px 0 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .re-lede,
  .re-info,
  .re-legend,
  .re-about {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .re-seg {
    display: inline-flex;
    margin-top: 12px;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .re-seg button,
  .re-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .re-periods {
    margin-left: 8px;
  }
  .re-periods[hidden] {
    display: none;
  }
  .re-seg button[aria-pressed='true'] {
    background: #e6e6df;
    color: #111210;
  }
  .re-clock {
    margin: 14px 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    color: #fff;
    text-transform: capitalize;
  }
  .re-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  .re-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .re-range-label {
    flex: 1;
  }
  .re-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .re-legend[hidden] {
    display: none;
  }
  .re-ramp {
    display: block;
    height: 10px;
    border-radius: 2px;
    margin-bottom: 4px;
  }
  .re-status {
    margin: 6px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .re-status:empty {
    display: none;
  }
  .re-about summary {
    cursor: pointer;
    margin-top: 8px;
  }
  .re-sources {
    font-size: var(--gs-texto-xs);
  }
  @media (max-width: 700px) {
    .re-stage {
      top: 8px;
      left: 8px;
      right: 8px;
      bottom: 46%;
    }
    .re-panel {
      top: auto;
      bottom: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 44%;
    }
    .re-lede {
      display: none;
    }
  }
</style>

<script>
  import { start } from '../respira/respira';
  start();
</script>
