---
// A century of population in every concello (INE censuses 1900–2021, on today's boundaries):
// concellos coloured by their population against 1900, jumping from census to census with no
// interpolation. The same figures are given as text: panel, census bars (labelled), the
// selected concello's detail and a table.
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="se-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="se-map" role="region" aria-label={t(lang, 'century_map_label')}></div>

  <section class="se-panel" id="contido">
    <a class="se-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'century_title')}</h1>
    <p class="se-lede">{t(lang, 'century_lede')}</p>
    <p class="se-clock" aria-live="off">--:--</p>
    <p class="se-now" aria-live="off"></p>
    <div class="se-detail" aria-live="polite"></div>
    <div class="se-controls">
    </div>
    <div class="se-controls">
      <button type="button" class="se-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
      <label>
        <span class="visually-hidden">{t(lang, 'pulse_speed')}</span>
        <select class="se-speed"></select>
      </label>
    </div>
    <label class="se-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="se-range" type="range" />
    </label>
    <p class="se-legend">
      <span class="se-scale" aria-hidden="true"><span>25 %</span><span>100 %</span><span>400 %</span></span>
      {t(lang, 'century_legend')}
    </p>
    <p class="se-status" role="status">{t(lang, 'loading')}</p>
    <details class="se-table">
      <summary>{t(lang, 'cities_table')}</summary>
      <table>
        <caption></caption>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'fire_col_concello')}</th>
            <th scope="col">1900</th>
            <th scope="col">{t(lang, 'century_col_year')}</th>
            <th scope="col">{t(lang, 'century_col_index')}</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </details>
    <details class="se-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'century_note')}</p>
      <p class="se-sources"></p>
    </details>
  </section>

  <figure class="se-curve">
    <figcaption>{t(lang, 'century_curve')}</figcaption>
    <svg role="img" preserveAspectRatio="none"></svg>
  </figure>
</div>

<style is:global>
  .se-app {
    position: relative;
    height: calc(100dvh - var(--ga-head, 52px));
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .se-map,
  .se-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .se-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .se-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .se-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .se-back:hover,
  .se-back:focus-visible {
    color: #fff;
  }
  .se-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .se-lede,
  .se-legend,
  .se-about,
  .se-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .se-about summary,
  .se-table summary {
    cursor: pointer;
  }
  .se-sources {
    font-size: var(--gs-texto-xs);
  }
  .se-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .se-app .se-clock {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .se-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .se-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .se-status:empty {
    display: none;
  }
  .se-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .se-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .se-seg button,
  .se-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .se-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .se-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .se-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .se-range-label {
    display: block;
    margin-top: 10px;
  }
  .se-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .se-mode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--gs-texto-sm);
    cursor: pointer;
  }
  .se-mode input {
    width: 16px;
    height: 16px;
    accent-color: #e6e6df;
  }
  .se-scale {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: var(--gs-texto-xs);
    color: #111210;
    background: linear-gradient(90deg, #7f3b08, #e08214 25%, #fdb863 40%, #f7f7f2 50%, #b2abd2 65%, #8073ac 80%, #2d004b);
  }
  .se-scale span:first-child {
    color: #fff;
  }
  .se-scale span:last-child {
    color: #fff;
  }
  .se-scale span:nth-child(2) {
    color: #111210;
  }
  .se-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .se-dot-in {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .se-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .se-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .se-table th,
  .se-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .se-table th:first-child,
  .se-table td:first-child {
    text-align: left;
  }
  .se-curve {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 12px;
    margin: 0;
    height: 120px;
  }
  .se-curve figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .se-curve svg {
    display: block;
    width: 100%;
    height: 100px;
    cursor: ew-resize;
    touch-action: none;
  }
  .se-tick {
    fill: #8a8a82;
    font-size: 11px;
    text-anchor: middle;
  }
  .se-bar {
    fill: rgba(230, 230, 223, 0.25);
    cursor: pointer;
  }
  .se-bar.is-now {
    fill: #b2abd2;
  }
  .se-bar.is-missing {
    fill: none;
    stroke: rgba(230, 230, 223, 0.35);
    stroke-dasharray: 3 3;
  }
  .se-mine {
    fill: #fff;
  }
  .se-mine-line {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .se-detail {
    margin-top: 8px;
    font-size: var(--gs-texto-sm);
  }
  .se-detail:empty {
    display: none;
  }
  .se-detail strong {
    color: #fff;
  }
  .se-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid #fdae61;
    color: #fdae61;
    font-size: var(--gs-texto-xs);
    vertical-align: middle;
  }
  .se-area {
    fill: none;
    stroke: #ff7a3d;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .se-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .se-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .se-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .se-lede,
    .se-legend {
      display: none;
    }
    .se-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .se-now {
      min-height: 0;
    }
    .se-controls {
      margin-top: 8px;
    }
    .se-curve {
      left: 8px;
      right: 8px;
      height: 96px;
    }
    .se-curve svg {
      height: 76px;
    }
  }
</style>

<script>
  import { start } from '../pulso/seculo/seculo';
  start();
</script>
