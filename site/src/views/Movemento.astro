---
// Trips between Galician zones through a mean Wednesday and Sunday (May 2025): particles on
// curved lanes between zone centroids. The same figures are given as text: panel, the curve
// of trips per hour (labelled) and a table of the largest flows.
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="mv-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="mv-map" role="region" aria-label={t(lang, 'moves_map_label')}></div>
  <canvas class="mv-canvas" aria-hidden="true"></canvas>

  <section class="mv-panel" id="contido">
    <a class="mv-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'moves_title')}</h1>
    <p class="mv-lede">{t(lang, 'moves_lede')}</p>
    <p class="mv-clock" aria-live="off">--:--</p>
    <p class="mv-now" aria-live="off"></p>
    <div class="mv-controls">
      <div class="mv-seg" role="group" aria-label={t(lang, 'pulse_day')}>
        <button type="button" data-day="mercores" aria-pressed="true">{t(lang, 'pulse_weekday')}</button>
        <button type="button" data-day="domingo" aria-pressed="false">{t(lang, 'pulse_sunday')}</button>
      </div>
    </div>
    <div class="mv-controls">
      <button type="button" class="mv-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
      <label>
        <span class="visually-hidden">{t(lang, 'pulse_speed')}</span>
        <select class="mv-speed"></select>
      </label>
    </div>
    <label class="mv-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="mv-range" type="range" />
    </label>
    <p class="mv-legend">
      <span class="mv-dot mv-dot-in" aria-hidden="true"></span>
      {t(lang, 'moves_legend')}
    </p>
    <p class="mv-status" role="status">{t(lang, 'loading')}</p>
    <details class="mv-table">
      <summary>{t(lang, 'cities_table')}</summary>
      <table>
        <caption></caption>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'moves_col_pair')}</th>
            <th scope="col">{t(lang, 'moves_col_km')}</th>
            <th scope="col">{t(lang, 'moves_col_day')}</th>
            <th scope="col">{t(lang, 'moves_col_peak')}</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </details>
    <details class="mv-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'moves_note')}</p>
      <p class="mv-sources"></p>
    </details>
  </section>

  <figure class="mv-curve">
    <figcaption>{t(lang, 'moves_curve')}</figcaption>
    <svg role="img" preserveAspectRatio="none"></svg>
  </figure>
</div>

<style is:global>
  .mv-app {
    position: relative;
    height: calc(100dvh - 52px);
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .mv-map,
  .mv-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mv-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .mv-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .mv-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .mv-back:hover,
  .mv-back:focus-visible {
    color: #fff;
  }
  .mv-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .mv-lede,
  .mv-legend,
  .mv-about,
  .mv-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .mv-about summary,
  .mv-table summary {
    cursor: pointer;
  }
  .mv-sources {
    font-size: var(--gs-texto-xs);
  }
  .mv-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .mv-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .mv-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .mv-status:empty {
    display: none;
  }
  .mv-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .mv-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .mv-seg button,
  .mv-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .mv-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .mv-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .mv-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .mv-range-label {
    display: block;
    margin-top: 10px;
  }
  .mv-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .mv-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .mv-dot-in {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .mv-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .mv-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .mv-table th,
  .mv-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .mv-table th:first-child,
  .mv-table td:first-child {
    text-align: left;
  }
  .mv-curve {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 12px;
    margin: 0;
    height: 120px;
  }
  .mv-curve figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .mv-curve svg {
    display: block;
    width: 100%;
    height: 100px;
    cursor: ew-resize;
    touch-action: none;
  }
  .mv-tick {
    fill: #8a8a82;
    font-size: 11px;
    text-anchor: middle;
  }
  .mv-area {
    fill: rgba(95, 211, 243, 0.2);
    stroke: #5fd3f3;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mv-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .mv-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .mv-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .mv-lede,
    .mv-legend {
      display: none;
    }
    .mv-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .mv-now {
      min-height: 0;
    }
    .mv-controls {
      margin-top: 8px;
    }
    .mv-curve {
      left: 8px;
      right: 8px;
      height: 96px;
    }
    .mv-curve svg {
      height: 76px;
    }
  }
</style>

<script>
  import { start } from '../pulso/movemento/movemento';
  start();
</script>
