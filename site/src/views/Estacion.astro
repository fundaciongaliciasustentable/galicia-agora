---
// Seasonal population load of every concello, quarter by quarter (IGE): concellos coloured by
// the people they support against their residents, jumping from quarter to quarter with no
// interpolation. The same figures are given as text: panel, quarter bars (labelled), the
// selected concello's detail and a table.
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="es-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="es-map" role="region" aria-label={t(lang, 'season_map_label')}></div>

  <section class="es-panel" id="contido">
    <a class="es-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'season_title')}</h1>
    <p class="es-lede">{t(lang, 'season_lede')}</p>
    <p class="es-clock" aria-live="off">--:--</p>
    <p class="es-now" aria-live="off"></p>
    <div class="es-detail" aria-live="polite"></div>
    <div class="es-controls">
    </div>
    <div class="es-controls">
      <button type="button" class="es-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
      <label>
        <span class="visually-hidden">{t(lang, 'pulse_speed')}</span>
        <select class="es-speed"></select>
      </label>
    </div>
    <label class="es-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="es-range" type="range" />
    </label>
    <p class="es-legend">
      <span class="es-scale" aria-hidden="true"><span>60 %</span><span>100 %</span><span>180 %</span></span>
      {t(lang, 'season_legend')}
    </p>
    <p class="es-status" role="status">{t(lang, 'loading')}</p>
    <details class="es-table">
      <summary>{t(lang, 'cities_table')}</summary>
      <table>
        <caption></caption>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'fire_col_concello')}</th>
            <th scope="col">{t(lang, 'season_col_rate')}</th>
            <th scope="col">{t(lang, 'season_col_load')}</th>
            <th scope="col">{t(lang, 'season_col_res')}</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </details>
    <details class="es-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'season_note')}</p>
      <p class="es-sources"></p>
    </details>
  </section>

  <figure class="es-curve">
    <figcaption>{t(lang, 'season_curve')}</figcaption>
    <svg role="img" preserveAspectRatio="none"></svg>
  </figure>
</div>

<style is:global>
  .es-app {
    position: relative;
    height: calc(100dvh - 52px);
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .es-map,
  .es-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .es-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .es-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .es-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .es-back:hover,
  .es-back:focus-visible {
    color: #fff;
  }
  .es-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .es-lede,
  .es-legend,
  .es-about,
  .es-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .es-about summary,
  .es-table summary {
    cursor: pointer;
  }
  .es-sources {
    font-size: var(--gs-texto-xs);
  }
  .es-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .es-app .es-clock {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .es-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .es-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .es-status:empty {
    display: none;
  }
  .es-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .es-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .es-seg button,
  .es-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .es-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .es-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .es-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .es-range-label {
    display: block;
    margin-top: 10px;
  }
  .es-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .es-mode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--gs-texto-sm);
    cursor: pointer;
  }
  .es-mode input {
    width: 16px;
    height: 16px;
    accent-color: #e6e6df;
  }
  .es-scale {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: var(--gs-texto-xs);
    color: #111210;
    background: linear-gradient(90deg, #2c7bb6, #abd9e9 30%, #f7f7f2 50%, #fdae61 75%, #d7191c);
  }
  .es-scale span:first-child {
    color: #fff;
  }
  .es-scale span:last-child {
    color: #fff;
  }
  .es-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .es-dot-in {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .es-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .es-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .es-table th,
  .es-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .es-table th:first-child,
  .es-table td:first-child {
    text-align: left;
  }
  .es-curve {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 12px;
    margin: 0;
    height: 120px;
  }
  .es-curve figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .es-curve svg {
    display: block;
    width: 100%;
    height: 100px;
    cursor: ew-resize;
    touch-action: none;
  }
  .es-tick {
    fill: #8a8a82;
    font-size: 11px;
    text-anchor: middle;
  }
  .es-bar {
    fill: rgba(230, 230, 223, 0.25);
    cursor: pointer;
  }
  .es-bar.is-now {
    fill: #fdae61;
  }
  .es-bar.is-missing {
    fill: none;
    stroke: rgba(230, 230, 223, 0.35);
    stroke-dasharray: 3 3;
  }
  .es-mine {
    fill: #fff;
  }
  .es-mine-line {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .es-detail {
    margin-top: 8px;
    font-size: var(--gs-texto-sm);
  }
  .es-detail:empty {
    display: none;
  }
  .es-detail strong {
    color: #fff;
  }
  .es-badge {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid #fdae61;
    color: #fdae61;
    font-size: var(--gs-texto-xs);
    vertical-align: middle;
  }
  .es-area {
    fill: none;
    stroke: #ff7a3d;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .es-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .es-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .es-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .es-lede,
    .es-legend {
      display: none;
    }
    .es-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .es-now {
      min-height: 0;
    }
    .es-controls {
      margin-top: 8px;
    }
    .es-curve {
      left: 8px;
      right: 8px;
      height: 96px;
    }
    .es-curve svg {
      height: 76px;
    }
  }
</style>

<script>
  import { start } from '../pulso/estacion/estacion';
  start();
</script>
