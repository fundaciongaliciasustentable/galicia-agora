---
// The weather of one day hour by hour at the MeteoGalicia stations (21 May 2025): light from
// the measured sunshine, temperature as colour around each station, wind particles and rain.
// The same figures are given as text: panel, curve (labelled) and an hourly table.
import { base, dictionary, type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="tp-app" data-lang={lang} data-dict={JSON.stringify(dictionary(lang))}>
  <div class="tp-map" role="region" aria-label={t(lang, 'weather_map_label')}></div>
  <canvas class="tp-canvas" aria-hidden="true"></canvas>

  <section class="tp-panel" id="contido">
    <a class="tp-back" href={`${base(lang)}pulso/`}>← {t(lang, 'pulse_back')}</a>
    <h1>{t(lang, 'weather_title')}</h1>
    <p class="tp-lede">{t(lang, 'weather_lede')}</p>
    <p class="tp-clock" aria-live="off">--:--</p>
    <p class="tp-now" aria-live="off"></p>
    <div class="tp-controls">
      <label class="tp-mode"><input type="checkbox" data-layer="temp" checked /> {t(lang, 'weather_temp')}</label>
      <label class="tp-mode"><input type="checkbox" data-layer="wind" checked /> {t(lang, 'weather_wind')}</label>
      <label class="tp-mode"><input type="checkbox" data-layer="rain" checked /> {t(lang, 'weather_rain')}</label>
    </div>
    <div class="tp-controls">
      <button type="button" class="tp-play" aria-pressed="false">{t(lang, 'pulse_play')}</button>
      <label>
        <span class="visually-hidden">{t(lang, 'pulse_speed')}</span>
        <select class="tp-speed"></select>
      </label>
    </div>
    <label class="tp-range-label">
      <span class="visually-hidden">{t(lang, 'pulse_time')}</span>
      <input class="tp-range" type="range" />
    </label>
    <p class="tp-legend">
      <span class="tp-scale" aria-hidden="true"><span>4 °C</span><span>32 °C</span></span>
      {t(lang, 'weather_legend')}
    </p>
    <p class="tp-status" role="status">{t(lang, 'loading')}</p>
    <details class="tp-table">
      <summary>{t(lang, 'cities_table')}</summary>
      <table>
        <caption></caption>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'pulse_time')}</th>
            <th scope="col">{t(lang, 'weather_col_mean')}</th>
            <th scope="col">{t(lang, 'weather_col_min')}</th>
            <th scope="col">{t(lang, 'weather_col_max')}</th>
            <th scope="col">{t(lang, 'weather_col_rain')}</th>
            <th scope="col">{t(lang, 'weather_col_wind')}</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </details>
    <details class="tp-about">
      <summary>{t(lang, 'pulse_about')}</summary>
      <p>{t(lang, 'weather_note')}</p>
      <p class="tp-sources"></p>
    </details>
  </section>

  <figure class="tp-curve">
    <figcaption>{t(lang, 'weather_curve')}</figcaption>
    <svg role="img" preserveAspectRatio="none"></svg>
  </figure>
</div>

<style is:global>
  .tp-app {
    position: relative;
    height: calc(100dvh - 52px);
    overflow: hidden;
    background: #111210;
    color: #e6e6df;
  }
  .tp-map,
  .tp-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tp-canvas {
    pointer-events: none;
    z-index: 1;
  }
  .tp-panel {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    width: min(360px, calc(100% - 32px));
    max-height: calc(100% - 190px);
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: var(--gs-radius-card);
    background: rgba(17, 18, 16, 0.8);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }
  .tp-back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
  }
  .tp-back:hover,
  .tp-back:focus-visible {
    color: #fff;
  }
  .tp-panel h1 {
    margin: 0;
    font-size: var(--gs-texto-xl);
    color: #fff;
  }
  .tp-lede,
  .tp-legend,
  .tp-about,
  .tp-table {
    font-size: var(--gs-texto-sm);
    color: #b3b3aa;
    margin: 6px 0 0;
  }
  .tp-about summary,
  .tp-table summary {
    cursor: pointer;
  }
  .tp-sources {
    font-size: var(--gs-texto-xs);
  }
  .tp-clock {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .tp-now {
    margin: 4px 0 0;
    font-variant-numeric: tabular-nums;
    min-height: 2.8em;
    font-size: var(--gs-texto-sm);
  }
  .tp-status {
    margin: 4px 0 0;
    font-size: var(--gs-texto-sm);
    color: #e0a95a;
  }
  .tp-status:empty {
    display: none;
  }
  .tp-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .tp-seg {
    display: flex;
    border: 1px solid #3a3b35;
    border-radius: 999px;
    padding: 2px;
  }
  .tp-seg button,
  .tp-play {
    font: inherit;
    font-size: var(--gs-texto-sm);
    border: 0;
    border-radius: 999px;
    padding: 4px 12px;
    background: transparent;
    color: #e6e6df;
    cursor: pointer;
  }
  .tp-seg button[aria-pressed="true"] {
    background: #e6e6df;
    color: #111210;
  }
  .tp-play {
    border: 1px solid #e6e6df;
    min-width: 6em;
  }
  .tp-speed {
    font: inherit;
    font-size: var(--gs-texto-sm);
    background: #1f201c;
    color: #e6e6df;
    border: 1px solid #3a3b35;
    border-radius: var(--gs-radius);
    padding: 3px 6px;
  }
  .tp-range-label {
    display: block;
    margin-top: 10px;
  }
  .tp-range {
    width: 100%;
    accent-color: #e6e6df;
  }
  .tp-mode {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--gs-texto-sm);
    cursor: pointer;
  }
  .tp-mode input {
    width: 16px;
    height: 16px;
    accent-color: #e6e6df;
  }
  .tp-scale {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: var(--gs-texto-xs);
    color: #111210;
    background: linear-gradient(
      90deg,
      rgb(49, 54, 149),
      rgb(69, 117, 180) 21%,
      rgb(116, 173, 209) 36%,
      rgb(224, 243, 248) 46%,
      rgb(254, 224, 144) 57%,
      rgb(253, 174, 97) 71%,
      rgb(244, 109, 67) 86%,
      rgb(165, 0, 38)
    );
  }
  .tp-scale span:first-child {
    color: #fff;
  }
  .tp-scale span:last-child {
    color: #fff;
  }
  .tp-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 3px;
  }
  .tp-dot-in {
    background: #5fd3f3;
    margin-right: 6px;
  }
  .tp-table table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    font-size: var(--gs-texto-xs);
    color: #e6e6df;
  }
  .tp-table caption {
    text-align: left;
    color: #b3b3aa;
    padding-bottom: 4px;
  }
  .tp-table th,
  .tp-table td {
    padding: 2px 4px;
    border-bottom: 1px solid #2a2b26;
    text-align: right;
  }
  .tp-table th:first-child,
  .tp-table td:first-child {
    text-align: left;
  }
  .tp-curve {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 64px;
    bottom: 12px;
    margin: 0;
    height: 120px;
  }
  .tp-curve figcaption {
    font-size: var(--gs-texto-xs);
    color: #b3b3aa;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tp-curve svg {
    display: block;
    width: 100%;
    height: 100px;
    cursor: ew-resize;
    touch-action: none;
  }
  .tp-tick {
    fill: #8a8a82;
    font-size: 11px;
    text-anchor: middle;
  }
  .tp-band {
    fill: rgba(253, 174, 97, 0.18);
  }
  .tp-sun {
    fill: rgba(255, 236, 160, 0.08);
  }
  .tp-area {
    fill: none;
    stroke: #fdae61;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .tp-other {
    fill: none;
    stroke: rgba(230, 230, 223, 0.45);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .tp-playhead {
    stroke: #fff;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 700px) {
    .tp-panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 48%;
      padding: 12px 14px;
    }
    .tp-lede,
    .tp-legend {
      display: none;
    }
    .tp-clock {
      margin-top: 4px;
      font-size: 2.2rem;
    }
    .tp-now {
      min-height: 0;
    }
    .tp-controls {
      margin-top: 8px;
    }
    .tp-curve {
      left: 8px;
      right: 8px;
      height: 96px;
    }
    .tp-curve svg {
      height: 76px;
    }
  }
</style>

<script>
  import { start } from '../pulso/tempo/tempo';
  start();
</script>
